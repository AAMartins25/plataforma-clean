# Exemplo sem credenciais. Configurar URL/chave privadamente no backend.
# Mesmo projeto Supabase; DATABASE_URL e SECRET_KEY devem ser próprios do ambiente.
# Não copiar o banco, runtime.json, tokens ou metadados fictícios da homologação.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_IMAGENS_BUCKET=teoria-imagens
IMAGENS_MANUTENCAO_ATIVA=false
IMAGENS_HOSTS_PERMITIDOS=
